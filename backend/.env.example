# ==============================
# Backend 環境変数
# Railway の Variables に設定する
# ==============================

# ----------------------------
# データベース
# ----------------------------

# PostgreSQL接続文字列（RailwayがDATABASE_URLを自動設定）
DATABASE_URL=postgresql://user:password@localhost:5432/saas_db

# ----------------------------
# サーバー
# ----------------------------

# サーバーポート（Railwayが自動設定）
PORT=3001

# ----------------------------
# 認証
# ----------------------------

# JWT署名シークレット（必須・本番は openssl rand -hex 32 で生成）
JWT_SECRET=change-me-in-production-use-random-256bit-string

# スーパー管理者メールアドレス（このメールでログインするとsuperadmin権限付与）
SUPERADMIN_EMAIL=

# ----------------------------
# URL
# ----------------------------

# フロントエンドURL（CORS・リダイレクト先・メール本文リンク）
# 本番: https://comiu.jp
FRONTEND_URL=http://localhost:3000

# バックエンドURL（LINE OAuthコールバック先）
# 本番: https://comiu.up.railway.app
BACKEND_URL=http://localhost:3001

# ----------------------------
# LINE Login（管理者登録・ログイン）
# ----------------------------

LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ----------------------------
# Gmail（メール送信）
# Google Cloud Console → OAuth 2.0 クライアントID で取得
# ----------------------------

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# ----------------------------
# Stripe（COMIUのSaaSサブスクリプション課金）
# テナントごとのStripeキーはDBに保存するため不要
# ----------------------------

STRIPE_BILLING_SECRET_KEY=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BILLING_WEBHOOK_SECRET=
