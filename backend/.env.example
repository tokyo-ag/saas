# ==============================
# Backend 環境変数
# Railway の Variables に設定する
# ==============================

# ----------------------------
# データベース
# ----------------------------

# PostgreSQL接続文字列（RailwayがDATABASE_URLを自動設定）
DATABASE_URL=postgresql://user:password@localhost:5432/saas_db

# ----------------------------
# サーバー
# ----------------------------

# サーバーポート（Railwayが自動設定）
PORT=3001

# ----------------------------
# 認証
# ----------------------------

# JWT署名シークレット（必須・本番は openssl rand -hex 32 で生成）
JWT_SECRET=change-me-in-production-use-random-256bit-string

# スーパー管理者メールアドレス（このメールでログインするとsuperadmin権限付与）
SUPERADMIN_EMAIL=

# スーパー管理者のSMS確認コード送信先電話番号（E.164形式。例: 日本の090xxxxxxxxなら+8190xxxxxxxx）
SUPERADMIN_PHONE_NUMBER=

# ----------------------------
# URL
# ----------------------------

# フロントエンドURL（CORS・リダイレクト先・メール本文リンク）
# 本番: https://comiu.link
FRONTEND_URL=http://localhost:3000

# 追加CORSオリジン（カンマ区切り。VercelプレビューURLなど）
# 例: https://comiu-pr-123-yourteam.vercel.app,https://staging.comiu.link
CORS_ORIGINS=

# バックエンドURL（LINE OAuthコールバック先）
# 本番: https://comiu.up.railway.app
BACKEND_URL=http://localhost:3001

# ----------------------------
# LINE Login（未使用の公開エンドポイント用に残置。主催者ログイン自体は廃止済み）
# ----------------------------

LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LIFF ID token検証用のChannel ID（任意）
# テナントにLIFF IDが保存されている場合は、LIFF IDの先頭部分から自動判定する
LIFF_CHANNEL_ID=

# ----------------------------
# Twilio（主催者ログインの2段階認証・SMS送信）
# https://www.twilio.com/ でアカウント作成し、SIDとAuth Token、
# SMS送信可能な電話番号（+1形式）を取得する
# 未設定の場合はSMS送信をスキップしログ出力のみ行う（開発用）
# ----------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ----------------------------
# Gmail（メール送信）
# Google Cloud Console → OAuth 2.0 クライアントID で取得
# ----------------------------

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# ----------------------------
# Stripe（COMIUのSaaSサブスクリプション課金）
# テナントごとのStripeキーはDBに保存するため不要
# ----------------------------

STRIPE_BILLING_SECRET_KEY=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BILLING_WEBHOOK_SECRET=

# ----------------------------
# Sentry（エラー監視）
# sentry.io でプロジェクト作成後に取得
# ----------------------------

SENTRY_DSN=
