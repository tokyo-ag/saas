# COMIU バックアップ設定テンプレート
#
# このファイルをコピーして .env.backup を作成し、実際の値を設定してください。
#   cp .env.backup.template .env.backup
#   # .env.backup を編集して実際の値を入力
#
# .env.backup は .gitignore 対象です（Gitにコミットしないでください）。
# このテンプレートファイル（.env.backup.template）はGit管理します。

# Railway PostgreSQL接続URL
# Railway ダッシュボード > Variables > DATABASE_URL の値をコピーしてください
PGBACKUP_DATABASE_URL=postgresql://postgres:PASSWORD@turntable.proxy.rlwy.net:15242/railway

# バックアップファイルの暗号化パスフレーズ（gpg --symmetric に使用）
# 十分に強いランダム文字列を設定してください（例: openssl rand -base64 32）
# 復号に必要なため、このパスフレーズを安全な場所（パスワードマネージャー等）に保管してください
GPG_PASSPHRASE=your-strong-passphrase-here

# バックアップの保存ディレクトリ（WSLパス）
# デフォルト: /mnt/c/saas/backup
BACKUP_DIR=/mnt/c/saas/backup
