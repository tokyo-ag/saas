generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  open
  closed
}

enum ReservationStatus {
  waiting_payment
  reserved
  waitlisted
  attended
  cancelled
}

enum Plan {
  free
  standard
}

model Tenant {
  id                     String    @id @default(uuid())
  name                   String    @db.VarChar(100)
  description            String?   @db.Text
  lineChannelId          String?   @map("line_channel_id") @db.VarChar(100)
  lineChannelSecret      String?   @map("line_channel_secret") @db.VarChar(100)
  lineChannelAccessToken String?   @map("line_channel_access_token") @db.Text
  liffId                 String?   @map("liff_id") @db.VarChar(100)
  stripeAccountId        String?   @map("stripe_account_id") @db.VarChar(100)
  plan                   Plan      @default(free)
  planStartedAt          DateTime? @map("plan_started_at")
  stripeCustomerId       String?   @map("stripe_customer_id") @db.VarChar(100)
  stripeSubscriptionId   String?   @map("stripe_subscription_id") @db.VarChar(100)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  events  Event[]
  members Member[]

  @@map("tenants")
}

model Event {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  title           String      @db.VarChar(100)
  description     String?     @db.Text
  heldAt          DateTime    @map("held_at")
  location        String      @db.VarChar(200)
  capacity        Int?
  status          EventStatus @default(draft)
  price           Int         @default(0)
  paymentRequired Boolean     @default(false) @map("payment_required")
  notifyOnReserve Boolean     @default(true) @map("notify_on_reserve")
  remindEnabled   Boolean     @default(false) @map("remind_enabled")
  remindAt        DateTime?   @map("remind_at")
  remindedAt      DateTime?   @map("reminded_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  reservations Reservation[]

  @@map("events")
}

model Member {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  lineUserId String   @map("line_user_id") @db.VarChar(100)
  name       String?  @db.VarChar(100)
  grade      String?  @db.VarChar(50)
  gender     String?  @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  reservations Reservation[]

  @@unique([tenantId, lineUserId])
  @@map("members")
}

model Reservation {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  eventId               String            @map("event_id")
  memberId              String            @map("member_id")
  status                ReservationStatus @default(reserved)
  waitlistOrder         Int?              @map("waitlist_order")
  stripePaymentIntentId String?           @map("stripe_payment_intent_id") @db.VarChar(100)
  paidAt                DateTime?         @map("paid_at")
  reservedAt            DateTime          @default(now()) @map("reserved_at")

  event  Event  @relation(fields: [eventId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@map("reservations")
}
