generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  open
  closed
}

enum ReservationStatus {
  waiting_payment
  reserved
  waitlisted
  attended
  cancelled
}

enum Plan {
  free
  standard
  pro
}

model Tenant {
  id                     String    @id @default(uuid())
  name                   String    @db.VarChar(100)
  description            String?   @db.Text
  lineChannelId          String?   @map("line_channel_id") @db.VarChar(100)
  lineChannelSecret      String?   @map("line_channel_secret") @db.VarChar(100)
  lineChannelAccessToken String?   @map("line_channel_access_token") @db.Text
  liffId                 String?   @map("liff_id") @db.VarChar(100)
  organizerLineUserId    String?   @map("organizer_line_user_id") @db.VarChar(100)
  lineDisplayName        String?   @map("line_display_name") @db.VarChar(100)
  linePictureUrl         String?   @map("line_picture_url") @db.Text
  stripeAccountId        String?   @map("stripe_account_id") @db.VarChar(100)
  stripeSecretKey        String?   @map("stripe_secret_key") @db.Text
  stripePublishableKey   String?   @map("stripe_publishable_key") @db.VarChar(200)
  stripeWebhookSecret    String?   @map("stripe_webhook_secret") @db.Text
  plan                   Plan      @default(free)
  planStartedAt          DateTime? @map("plan_started_at")
  stripeCustomerId       String?   @map("stripe_customer_id") @db.VarChar(100)
  stripeSubscriptionId   String?   @map("stripe_subscription_id") @db.VarChar(100)
  liffEventView          String    @default("card") @map("liff_event_view") @db.VarChar(20)
  activityTickerEnabled  Boolean   @default(true) @map("activity_ticker_enabled")
  themeColor             String    @default("green") @map("theme_color") @db.VarChar(20)
  iconUrl                String?   @map("icon_url") @db.Text
  publicBlogUrl          String?   @map("public_blog_url") @db.VarChar(500)
  tags                   String[]  @default([])
  typeTags               String[]  @default([]) @map("type_tags")
  activityTags           String[]  @default([]) @map("activity_tags")
  code                   String?   @unique @db.VarChar(32)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")
  bannedAt               DateTime? @map("banned_at")

  events             Event[]
  members            Member[]
  organizerAccounts  OrganizerAccount[]
  liffAccesses       TenantLiffAccess[]
  publicPages        PublicPage[]
  blogPosts          BlogPost[]

  @@map("tenants")
}

model PublicPage {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  title          String    @db.VarChar(120)
  slug           String    @db.VarChar(80)
  subtitle       String?   @db.Text
  body           String    @db.Text
  coverImageUrl  String?   @map("cover_image_url") @db.Text
  imageUrls      String[]  @default([]) @map("image_urls")
  imageCaptions  String[]  @default([]) @map("image_captions")
  dividerText    String?   @map("divider_text") @db.VarChar(80)
  textColor      String?   @map("text_color") @db.VarChar(20)
  accentColor    String?   @map("accent_color") @db.VarChar(20)
  backgroundColor String?  @map("background_color") @db.VarChar(20)
  navColor          String?  @map("nav_color") @db.VarChar(20)
  navOpacity        Int?     @map("nav_opacity")
  backgroundOpacity Int?     @map("background_opacity")
  imageLayout    String?   @map("image_layout") @db.VarChar(20)
  heroImageMode  String?   @map("hero_image_mode") @db.VarChar(20)
  heroNavPosition String?  @map("hero_nav_position") @db.VarChar(20)
  heroImagePosition String? @map("hero_image_position") @db.VarChar(30)
  heroTextPosition String?  @map("hero_text_position") @db.VarChar(20)
  heroTextX        Int?     @map("hero_text_x")
  heroTextY        Int?     @map("hero_text_y")
  heroTextWidth    Int?     @map("hero_text_width")
  buttonBgColor  String?   @map("button_bg_color") @db.VarChar(20)
  buttonBgOpacity Int?     @map("button_bg_opacity")
  buttonTextOpacity Int?   @map("button_text_opacity")
  blocks         Json?     @map("blocks")
  heroOverlayOpacity Int?  @map("hero_overlay_opacity")
  heroOverlayColor String? @map("hero_overlay_color") @db.VarChar(20)
  reserveViewStyle String? @map("reserve_view_style") @db.VarChar(20)
  fontFamily     String?   @map("font_family") @db.VarChar(40)
  titleFont      String?   @map("title_font") @db.VarChar(40)
  titleColor     String?   @map("title_color") @db.VarChar(20)
  titleSize      String?   @map("title_size") @db.VarChar(20)
  titleAlign     String?   @map("title_align") @db.VarChar(20)
  subtitleFont   String?   @map("subtitle_font") @db.VarChar(40)
  subtitleSize   String?   @map("subtitle_size") @db.VarChar(20)
  subtitleColor  String?   @map("subtitle_color") @db.VarChar(20)
  subtitleMarginTop Int?   @map("subtitle_margin_top")
  buttonRadius     Int?     @map("button_radius")
  buttonSize       Int?     @map("button_size")
  bodySize       String?   @map("body_size") @db.VarChar(20)
  layoutVariant  String?   @map("layout_variant") @db.VarChar(40)
  aboutLabel     String?   @map("about_label") @db.VarChar(40)
  reserveLabel   String?   @map("reserve_label") @db.VarChar(40)
  blogLabel      String?   @map("blog_label") @db.VarChar(40)
  contactLabel   String?   @map("contact_label") @db.VarChar(40)
  buttonStyle    String?   @map("button_style") @db.VarChar(20)
  buttonLayout   String?   @map("button_layout") @db.VarChar(20)
  buttonOpacity  Int?      @map("button_opacity")
  headerText     String?   @map("header_text") @db.Text
  footerText     String?   @map("footer_text") @db.Text
  seoTitle       String?   @map("seo_title") @db.VarChar(160)
  seoDescription String?   @map("seo_description") @db.VarChar(300)
  orgNameDisplayType  String  @default("text") @map("org_name_display_type") @db.VarChar(20)
  orgLogoWordmarkUrl  String? @map("org_logo_wordmark_url") @db.Text
  orgLogoWordmarkAlt  String? @map("org_logo_wordmark_alt") @db.VarChar(200)
  orgLogoWordmarkSize Int?    @map("org_logo_wordmark_size")
  status         String    @default("published") @db.VarChar(20)
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("public_pages")
}

model BlogPost {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  title       String    @db.VarChar(160)
  slug        String    @db.VarChar(120)
  body        String    @db.Text
  excerpt     String?   @db.VarChar(300)
  tags        String[]  @default([])
  status      String    @default("draft") @db.VarChar(20)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt(sort: Desc)])
  @@map("blog_posts")
}

model OfficialSiteSetting {
  id                String   @id @default("default")
  status            String   @default("published") @db.VarChar(20)
  heroTitle         String   @default("サークル・イベント運営をLINEでかんたんに") @map("hero_title") @db.VarChar(160)
  heroLead          String   @default("COMIUは、予約管理・参加者名簿・リマインド・問い合わせ対応をまとめて管理できる主催者向けWEBサービスです。") @map("hero_lead") @db.Text
  primaryCtaLabel   String   @default("無料ではじめる") @map("primary_cta_label") @db.VarChar(60)
  primaryCtaHref    String   @default("/register") @map("primary_cta_href") @db.VarChar(500)
  secondaryCtaLabel String   @default("相談する") @map("secondary_cta_label") @db.VarChar(60)
  secondaryCtaHref  String   @default("/contact") @map("secondary_cta_href") @db.VarChar(500)
  seoTitle          String?  @map("seo_title") @db.VarChar(160)
  seoDescription    String?  @map("seo_description") @db.VarChar(300)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("official_site_settings")
}

model OfficialArticle {
  id            String    @id @default(uuid())
  title         String    @db.VarChar(160)
  slug          String    @unique @db.VarChar(120)
  excerpt       String?   @db.VarChar(300)
  body          String    @db.Text
  category      String?   @db.VarChar(60)
  areaTags      String[]  @default([]) @map("area_tags")
  isPillar      Boolean   @default(false) @map("is_pillar")
  pillarSlug    String?   @map("pillar_slug") @db.VarChar(120)
  targetKeyword String?   @map("target_keyword") @db.VarChar(120)
  ctaTitle      String?   @map("cta_title") @db.VarChar(160)
  ctaDescription String?  @map("cta_description") @db.VarChar(300)
  ctaLabel      String?   @map("cta_label") @db.VarChar(80)
  ctaHref       String?   @map("cta_href") @db.VarChar(500)
  ogImageUrl    String?   @map("og_image_url") @db.Text
  status        String    @default("draft") @db.VarChar(20)
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, publishedAt(sort: Desc)])
  @@index([category])
  @@index([pillarSlug])
  @@map("official_articles")
}

model TenantLiffAccess {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  accessedAt DateTime @default(now()) @map("accessed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, accessedAt])
  @@map("tenant_liff_accesses")
}

model OrganizerAccount {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String?  @unique @db.VarChar(200)
  passwordHash String?  @map("password_hash") @db.Text
  lineUserId   String?  @unique @map("line_user_id") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  emailVerifiedAt        DateTime? @map("email_verified_at")
  emailVerificationToken String?   @unique @map("email_verification_token") @db.VarChar(200)
  passwordResetToken     String?   @unique @map("password_reset_token") @db.VarChar(200)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("organizer_accounts")
}

model Event {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  title           String      @db.VarChar(100)
  description     String?     @db.Text
  heldAt          DateTime    @map("held_at")
  endAt           DateTime?   @map("end_at")
  location        String      @db.VarChar(200)
  locationUrl     String?     @map("location_url") @db.VarChar(500)
  capacity        Int?
  capacityMale    Int?        @map("capacity_male")
  capacityFemale  Int?        @map("capacity_female")
  status          EventStatus @default(draft)
  price           Int         @default(0)
  priceMale       Int?        @map("price_male")
  priceFemale     Int?        @map("price_female")
  paymentRequired Boolean     @default(false) @map("payment_required")
  paymentTiming   String      @default("onsite") @map("payment_timing")
  notifyOnReserve    Boolean     @default(true) @map("notify_on_reserve")
  notifyOnReserveApp Boolean     @default(true) @map("notify_on_reserve_app")
  remindEnabled      Boolean     @default(false) @map("remind_enabled")
  remindApp          Boolean     @default(false) @map("remind_app")
  remindAt        DateTime?   @map("remind_at")
  remindedAt      DateTime?   @map("reminded_at")
  levelEnabled    Boolean     @default(false) @map("level_enabled")
  rosterShareEnabled Boolean  @default(false) @map("roster_share_enabled")
  rosterShareToken String?    @unique @map("roster_share_token") @db.VarChar(64)
  category        String?     @db.VarChar(50)
  tags            String[]    @default([])
  imageUrl        String?     @map("image_url") @db.Text
  iconUrl         String?     @map("icon_url") @db.Text
  viewCount       Int         @default(0) @map("view_count")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  reservations Reservation[]
  likes        EventLike[]
  reviews      EventReview[]

  @@map("events")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  memberId  String   @map("member_id")
  title     String   @db.VarChar(200)
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("notifications")
}

model Member {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  lineUserId          String    @map("line_user_id") @db.VarChar(100)
  lineDisplayName     String?   @map("line_display_name") @db.VarChar(200)
  linePictureUrl      String?   @map("line_picture_url") @db.VarChar(500)
  name                String?   @db.VarChar(100)
  grade               String?   @db.VarChar(50)
  gender              String?   @db.VarChar(20)
  level               String?   @db.VarChar(20)
  comment             String?   @db.VarChar(200)
  showEventsToConnections Boolean  @default(true) @map("show_events_to_connections")
  blockedAt           DateTime? @map("blocked_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  reservations  Reservation[]
  connections1  Connection[]   @relation("ConnectionMember1")
  connections2  Connection[]   @relation("ConnectionMember2")
  sentMessages    Message[]
  notifications   Notification[]
  eventReviews     EventReview[]

  @@unique([tenantId, lineUserId])
  @@map("members")
}

model Connection {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  member1Id String   @map("member1_id")
  member2Id String   @map("member2_id")
  createdAt DateTime @default(now()) @map("created_at")

  member1  Member    @relation("ConnectionMember1", fields: [member1Id], references: [id], onDelete: Cascade)
  member2  Member    @relation("ConnectionMember2", fields: [member2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([member1Id, member2Id])
  @@map("connections")
}

model Message {
  id           String   @id @default(uuid())
  connectionId String   @map("connection_id")
  senderId     String   @map("sender_id")
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     Member     @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model SupportMessage {
  id         String   @id @default(uuid())
  lineUserId String   @map("line_user_id") @db.VarChar(100)
  tenantId   String?  @map("tenant_id")
  content    String   @db.Text
  fromUser   Boolean  @default(true) @map("from_user")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([lineUserId])
  @@map("support_messages")
}

model PushSubscription {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  memberId  String?  @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([memberId])
  @@map("push_subscriptions")
}

model PendingRegistration {
  token        String   @id @db.VarChar(200)
  email        String   @db.VarChar(200)
  passwordHash String   @map("password_hash") @db.Text
  orgName      String   @map("org_name") @db.VarChar(100)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model BannedLineUser {
  id         String   @id @default(uuid())
  lineUserId String   @unique @map("line_user_id") @db.VarChar(100)
  reason     String?  @db.Text
  bannedAt   DateTime @default(now()) @map("banned_at")

  @@map("banned_line_users")
}

model EventLike {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  anonymousId String   @map("anonymous_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, anonymousId])
  @@map("event_likes")
}

model EventReview {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  eventId     String   @map("event_id")
  memberId    String   @map("member_id")
  content     String   @db.Text
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([tenantId, eventId])
  @@map("event_reviews")
}

model Reservation {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  eventId               String            @map("event_id")
  memberId              String            @map("member_id")
  status                ReservationStatus @default(reserved)
  waitlistOrder         Int?              @map("waitlist_order")
  stripePaymentIntentId String?           @map("stripe_payment_intent_id") @db.VarChar(100)
  paidAt                DateTime?         @map("paid_at")
  reservedAt            DateTime          @default(now()) @map("reserved_at")

  event  Event  @relation(fields: [eventId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@map("reservations")
}


model ErrorLog {
  id        String   @id @default(uuid())
  method    String   @db.VarChar(10)
  url       String   @db.VarChar(500)
  status    Int
  message   String   @db.Text
  stack     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("error_logs")
}
