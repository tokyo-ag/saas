# ==============================
# Frontend 環境変数
# Vercel の Environment Variables に設定する
# ==============================

# ----------------------------
# API接続
# ----------------------------

# バックエンドAPIの公開URL（クライアント・画像最適化用）
# Vercel: https://comiu.up.railway.app
# ローカル: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# バックエンドAPIのサーバーサイド専用URL（Railway内部ネットワーク経由・データフェッチ高速化）
# 設定しない場合は NEXT_PUBLIC_API_URL にフォールバック
# 例: https://comiu.up.railway.app（内部URLが使える場合はそちらを設定）
API_BASE_URL=

# ----------------------------
# サイト情報
# ----------------------------

# 本番サイトURL（canonical URL・OGP・JSON-LDで使用）
# 本番: https://comiu.link
NEXT_PUBLIC_SITE_URL=https://comiu.link

# 公開問い合わせ先（利用規約・プライバシーポリシーで使用）
NEXT_PUBLIC_SUPPORT_EMAIL=comiunoreply@gmail.com

# 公開公式LINE（お問い合わせページ・フッター・構造化データで使用）
NEXT_PUBLIC_OFFICIAL_LINE_URL=https://lin.ee/oLnMgPkA

# ----------------------------
# LINE
# ----------------------------

# LINE LIFF ID（LINE Developersで取得）
# 例: 1234567890-xxxxxxxx
NEXT_PUBLIC_LIFF_ID=

# ----------------------------
# アナリティクス
# ----------------------------

# Google Analytics測定ID（任意）
# 例: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ----------------------------
# ストレージ
# ----------------------------

# Vercel Blob（画像アップロード用）
# Vercelダッシュボード → Storage → Blob で取得
BLOB_READ_WRITE_TOKEN=

# ----------------------------
# 機能フラグ
# ----------------------------

# スポーツカテゴリページを非公開にする場合は true
# デプロイ後に段階的に公開する際に使用
NEXT_PUBLIC_DISCOVERY_LOCKED=

# ----------------------------
# Sentry（エラー監視）
# sentry.io でプロジェクト作成後に取得
# SENTRY_ORG / SENTRY_PROJECT はビルド時のソースマップアップロード用（任意）
# ----------------------------

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
